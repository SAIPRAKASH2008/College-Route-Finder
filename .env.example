# Server Configuration
PORT=3000
NODE_ENV=development

# Security & JWT Secrets
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=24h
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# 32-byte hex key for AES-256-CBC encryption of TOTP secrets
ENCRYPTION_KEY=replace-with-64-random-hex-characters
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters-long

# Nodemailer SMTP Configuration for Intruder Alert Emails
# (Use Gmail App Password, Ethereal, or any SMTP service)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=

# Rate Limiting & Lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
